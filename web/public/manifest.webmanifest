{
  "name": "Sarala",
  "short_name": "Sarala",
  "description": "A WYSIWYG Markdown editor. Your documents stay on your device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#faf6ef",
  "theme_color": "#faf6ef",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "text/markdown": [".md", ".markdown", ".mdown"] } }
  ]
}
